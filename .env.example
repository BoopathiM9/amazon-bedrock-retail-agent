# AWS Credentials & Region Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# Optional AWS Session Token (if using temporary/SSO credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Amazon Bedrock Agent Configuration
# Get these IDs from the AWS Bedrock Console after creating your Agent & Alias
BEDROCK_AGENT_ID=your_agent_id_here
BEDROCK_AGENT_ALIAS_ID=your_agent_alias_id_here

# UI Application Mode
# Set to 'true' to run locally with built-in mock responses without calling AWS Bedrock
MOCK_MODE=false
