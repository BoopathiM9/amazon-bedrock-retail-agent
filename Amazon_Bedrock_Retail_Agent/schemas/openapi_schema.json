{
  "openapi": "3.0.0",
  "info": {
    "title": "Retail Order and Product Management API",
    "version": "1.0.0",
    "description": "API for querying order statuses, customer orders, product catalog, and managing order cancellations or placements."
  },
  "paths": {
    "/orders/{orderId}": {
      "get": {
        "summary": "Get order details by order ID",
        "description": "Retrieves current status, delivery date, items, and total amount for a specific order ID.",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "The unique order ID (e.g., ORD-1001)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": {"type": "string"},
                    "customer_name": {"type": "string"},
                    "product_name": {"type": "string"},
                    "quantity": {"type": "integer"},
                    "total_amount": {"type": "number"},
                    "status": {"type": "string"},
                    "delivery_date": {"type": "string"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "List orders for a customer",
        "description": "Returns all orders associated with a customer name or customer ID.",
        "operationId": "listCustomerOrders",
        "parameters": [
          {
            "name": "customer",
            "in": "query",
            "required": true,
            "description": "Customer name or customer ID to search orders for (e.g. Alice Johnson or CUST-101)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {"type": "integer"},
                    "orders": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new order",
        "description": "Places a new order for a customer and updates inventory.",
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_name", "product"],
                "properties": {
                  "customer_name": {
                    "type": "string",
                    "description": "Full name of the customer placing the order"
                  },
                  "product": {
                    "type": "string",
                    "description": "Product ID (e.g. PROD-001) or product name"
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "Number of items to purchase (default 1)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order placed successfully"
          },
          "400": {
            "description": "Failed to create order (e.g. out of stock)"
          }
        }
      }
    },
    "/orders/{orderId}/cancel": {
      "post": {
        "summary": "Cancel an order",
        "description": "Cancels an order if eligible (status Processing or In Transit) and triggers a refund.",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "The unique order ID to cancel (e.g., ORD-1001)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "Reason for cancellation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order cancelled successfully"
          },
          "400": {
            "description": "Order cannot be cancelled"
          }
        }
      }
    },
    "/products/{productId}": {
      "get": {
        "summary": "Get product details and stock",
        "description": "Retrieves product specs, current price, and available inventory stock.",
        "operationId": "getProduct",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "description": "The product ID (e.g. PROD-001) or product name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "product_id": {"type": "string"},
                    "name": {"type": "string"},
                    "category": {"type": "string"},
                    "price": {"type": "number"},
                    "stock": {"type": "integer"},
                    "description": {"type": "string"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List available products in catalog",
        "description": "Lists all products or filters by category (e.g. Electronics, Accessories, Wearables).",
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter by product category",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog products retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {"type": "integer"},
                    "products": {
                      "type": "array",
                      "items": {"type": "object"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
